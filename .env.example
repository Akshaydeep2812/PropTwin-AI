# Copy to .env and replace every value. Local development only: production secrets belong in your host's secret manager.

# --- MySQL (Docker) ---
MYSQL_DATABASE=proptwin
MYSQL_USER=proptwin
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
# Host port. 3307 avoids clashing with a MySQL already installed on 3306.
MYSQL_HOST_PORT=3307
# Used when the API runs on your machine. Docker Compose builds its own URL from the values above.
DATABASE_URL=mysql+pymysql://proptwin:replace-with-a-local-password@localhost:3307/proptwin

# --- Application ---
# development | test | production. Production refuses placeholder secrets, insecure cookies and known test keys.
APP_ENV=development
# At least 32 random characters. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-local-secret
CORS_ORIGINS=["http://localhost:5173"]
# Base of the links in password-reset and verification emails.
FRONTEND_BASE_URL=http://localhost:5173
# Must be true whenever the site is served over HTTPS, and is enforced in production.
COOKIE_SECURE=false
VITE_API_BASE_URL=/api/v1
# Password for the seeded demo accounts. If unset, the seed script generates one and prints it once.
DEMO_PASSWORD=
# One-click demo sign-in on the sign-in page. Local demos only: the API refuses to start with this on in production.
DEMO_LOGIN_ENABLED=true

# --- Email (optional). Without SMTP_HOST, links print to the API console in development and nothing is sent. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# --- Blockchain. For a local node, `python scripts/configure_local_chain.py` fills these in. ---
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_NETWORK_NAME=hardhat-local
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS=
# Signs registrations and updates. Never commit a real key.
BLOCKCHAIN_RELAYER_PRIVATE_KEY=
# Blocks a transaction must be buried under before the app calls it confirmed. Use more on public networks.
BLOCKCHAIN_CONFIRMATIONS=1

# --- Operations ---
WORKER_ENABLED=true
WORKER_POLL_SECONDS=5
AUDIT_RETENTION_DAYS=730
RATE_LIMIT_ENABLED=true
